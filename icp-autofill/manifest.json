{
  "manifest_version": 3,
  "name": "CitaMate",
  "version": "1.8.0",
  "description": "Your cita helper: sign in to your CitaMate account, fill each page with one click, track every result and see which offices are open. You stay in control of every step.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CitaMate – manage entries"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "entries.html",
  "content_scripts": [
    {
      "matches": [
        "https://icp.administracionelectronica.gob.es/*",
        "https://sede.administracionespublicas.gob.es/*"
      ],
      "js": [
        "lib/site-config.js",
        "lib/snapshot.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://icp.administracionelectronica.gob.es/*",
        "https://sede.administracionespublicas.gob.es/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
