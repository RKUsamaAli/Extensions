{
  "manifest_version": 3,
  "name": "RelaySwitch",
  "version": "0.1.0",
  "description": "Switch between your own proxies from any provider, with login, sessions and an exit-IP check.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider", "scripting", "browsingData"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background/index.js" },
  "action": {
    "default_title": "RelaySwitch",
    "default_popup": "popup/index.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options/index.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
