# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
NODE_ENV=production
APP_SECRET=
# Optional separate key for encrypting personal data and proxy passwords at rest (64 hex chars).
# If you set it, back it up: without it the encrypted data cannot be read.
DATA_KEY=
PUBLIC_URL=https://api.example.com
HOST=127.0.0.1
PORT=4000
DB_FILE=./data/ext-hub.db
# Comma-separated Chrome Web Store ids of CitaMate and RelaySwitch. Empty = any extension (development only).
ALLOWED_EXTENSION_IDS=
TRUST_PROXY=1
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TTL_DAYS_EXTENSION=30
REFRESH_TTL_DAYS_PANEL=7
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15
API_RATE_LIMIT_RPM=600
LOG_LEVEL=info
