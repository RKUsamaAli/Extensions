# /etc/nginx/sites-available/ext-hub  (TLS via certbot: certbot --nginx -d api.example.com)
limit_req_zone $binary_remote_addr zone=exthub_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=exthub_api:10m rate=20r/s;

server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.example.com;
    # ssl_certificate / ssl_certificate_key added by certbot

    client_max_body_size 6m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /api/v1/auth/login {
        limit_req zone=exthub_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:4000;
        include /etc/nginx/proxy_params;
    }
    location / {
        limit_req zone=exthub_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:4000;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
