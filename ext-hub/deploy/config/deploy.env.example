# =============================================================================
# Server-side settings for the ext-hub deployment scripts.
#
# setup-server.sh writes this file to /etc/ext-hub/deploy.env the first time
# it runs (from your answers / command-line flags). Edit it there later, then
# run `sudo exthub-setup` to apply nginx / .env changes.
# Application settings (secrets, limits) live in /opt/ext-hub/shared/.env.
# =============================================================================

# --- Where things live ------------------------------------------------------------
APP_USER=exthub                         # Linux user that runs the app (no sudo rights)
BASE_DIR=/opt/ext-hub                   # releases/, shared/, current -> releases/<x>

# --- Source code ------------------------------------------------------------------
# HTTPS URL for a public repo, or SSH URL for a private one (setup creates a deploy key).
REPO_URL=https://github.com/RKUsamaAli/Extensions.git
REPO_BRANCH=main                        # what `exthub-deploy` deploys when no --ref is given
APP_SUBDIR=ext-hub                      # the Node.js server inside the repo
DEPLOY_SUBDIR=ext-hub/deploy            # these scripts inside the repo
CITAMATE_SUBDIR=icp-autofill            # CitaMate extension (zipped on every deploy)
RELAYSWITCH_SUBDIR=relayswitch          # RelaySwitch extension (built + zipped on every deploy)

# --- Address & TLS ----------------------------------------------------------------
# With a domain: API_DOMAIN=api.example.com and SSL_MODE=letsencrypt (A record -> this server).
# Without one:   leave API_DOMAIN empty, SSL_MODE=none; the server is reached at http://PUBLIC_IP.
API_DOMAIN=
PUBLIC_IP=                              # filled in by setup-server.sh (detected) or --public-ip
SSL_MODE=none                           # letsencrypt | custom | none
LETSENCRYPT_EMAIL=
SSL_CERT_PATH=                          # SSL_MODE=custom: e.g. Cloudflare origin certificate
SSL_KEY_PATH=

# --- Server -----------------------------------------------------------------------
SSH_PORT=22
NODE_MAJOR=22                           # Node.js LTS line to install
SWAP_SIZE_MB=1024                       # 0 = no swap file
TIMEZONE=UTC

# --- Deploy behaviour -------------------------------------------------------------
KEEP_RELEASES=5                         # old releases kept for rollback
KEEP_DB_BACKUPS=14                      # pre-deploy + daily DB backups kept
HEALTHCHECK_TIMEOUT=60                  # seconds to wait for a new release to become healthy
RUN_TESTS=true                          # run `npm test` before switching (skip: --skip-tests)
BUILD_EXTENSIONS=true                   # build the extension zips (skip: --skip-extensions)
AUTO_ROLLBACK=true                      # switch back automatically if the new release is unhealthy
