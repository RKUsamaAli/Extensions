# =============================================================================
# nginx site for ext-hub (plain HTTP)  -  generated by setup-server.sh
# Edit the template in the repo (ext-hub/deploy/templates/), not this file:
# it is overwritten by  sudo exthub-setup --nginx-only
#
# Used with SSL_MODE=none (no domain: http://<server ip>) and briefly while a
# Let's Encrypt certificate is being issued.
# =============================================================================

# ---- per-IP rate limits (first layer; the app adds its own login lockout) ----
limit_req_zone  $binary_remote_addr zone=exthub_login:10m rate=10r/m;
limit_req_zone  $binary_remote_addr zone=exthub_api:10m   rate=20r/s;
limit_req_status 429;

log_format exthub_main '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                       'rt=$request_time rid=$request_id "$http_user_agent"';

upstream exthub_app { server 127.0.0.1:{{APP_PORT}}; keepalive 16; }

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{SERVER_NAME}};
    gzip on; gzip_vary on; gzip_proxied any; gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    client_max_body_size 6m;
    access_log /var/log/nginx/ext-hub.access.log exthub_main;
    error_log  /var/log/nginx/ext-hub.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    # Extension zips built by exthub-deploy, with this server's address set as default.
    location /downloads/ {
        alias {{BASE_DIR}}/current/downloads/;
        autoindex on;
        add_header Cache-Control "no-cache";
    }
    location = /api/v1/auth/login {
        limit_req zone=exthub_login burst=5 nodelay;
        include /etc/nginx/snippets/ext-hub-proxy.conf;
        proxy_pass http://exthub_app;
    }
    location / {
        limit_req zone=exthub_api burst=60 nodelay;
        include /etc/nginx/snippets/ext-hub-proxy.conf;
        proxy_pass http://exthub_app;
    }
}
