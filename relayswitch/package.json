{
  "name": "relayswitch",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Switch between your own proxies, from any provider.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "npm run build && cd dist && zip -qr ../relayswitch.zip ."
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
